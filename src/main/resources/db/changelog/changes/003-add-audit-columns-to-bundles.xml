<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Add missing audit columns to bundles table (required by BaseEntity) -->
    <changeSet id="003-01-add-audit-columns-to-bundles" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="bundles" columnName="created_by"/>
            </not>
        </preConditions>
        <addColumn tableName="bundles">
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="updated_by" type="VARCHAR(255)"/>
            <column name="updated_at" type="DATETIME"/>
        </addColumn>
    </changeSet>

    <!-- Add version column to bundles table (required by BaseEntity @Version) -->
    <changeSet id="003-02-add-version-column-to-bundles" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="bundles" columnName="version"/>
            </not>
        </preConditions>
        <addColumn tableName="bundles">
            <column name="version" type="BIGINT" defaultValueNumeric="0"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
