<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-bundles-table" author="system">
        <createTable tableName="bundles">
            <column name="id" type="VARCHAR(300)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="operators_fingerprint" type="VARCHAR(255)"/>
            <column name="engine_type" type="VARCHAR(50)"/>
            <column name="compiler_id" type="VARCHAR(100)"/>
            <column name="drools_version" type="VARCHAR(20)"/>
            <column name="limit_per_customer" type="INT"/>
            <column name="limit_per_day" type="INT"/>
            <column name="artifact_store" type="VARCHAR(50)"/>
            <column name="artifact_key" type="VARCHAR(255)"/>
            <column name="artifact_size" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="validation_rule_version_id" type="VARCHAR(100)"/>
            <column name="snapshot_hash" type="VARCHAR(255)"/>
        </createTable>

        <createIndex tableName="bundles" indexName="idx_bundle_hash" unique="true">
            <column name="id"/>
        </createIndex>

        <createIndex tableName="bundles" indexName="idx_rule_version">
            <column name="tenant_id"/>
            <column name="rule_id"/>
            <column name="rule_version"/>
        </createIndex>

        <createIndex tableName="bundles" indexName="idx_tenant">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-bundle-time-links-table" author="system">
        <createTable tableName="bundle_time_links">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="policy_id" type="VARCHAR(100)"/>
            <column name="mode" type="VARCHAR(50)"/>
            <column name="bundle_id" type="VARCHAR(300)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="bundle_time_links"
                                 baseColumnNames="bundle_id"
                                 constraintName="fk_bundle_time_links_bundle"
                                 referencedTableName="bundles"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="003-create-bundle-subject-index-table" author="system">
        <createTable tableName="bundle_subject_index">
            <column name="id" type="VARCHAR(200)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="subject_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="subject_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="assignment_version" type="INT"/>
            <column name="bundle_hash" type="VARCHAR(300)"/>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="bundle_subject_index"
                             columnNames="tenant_id,subject_type,subject_key"
                             constraintName="uk_tenant_subject"/>

        <createIndex tableName="bundle_subject_index" indexName="idx_subject">
            <column name="tenant_id"/>
            <column name="subject_type"/>
            <column name="subject_key"/>
        </createIndex>

        <createIndex tableName="bundle_subject_index" indexName="idx_rule_ver">
            <column name="tenant_id"/>
            <column name="rule_id"/>
            <column name="rule_version"/>
        </createIndex>
    </changeSet>

    <changeSet id="004-create-bundle-warmups-table" author="system">
        <createTable tableName="bundle_warmups">
            <column name="id" type="VARCHAR(200)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="bundle_hash" type="VARCHAR(300)">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="attempts" type="INT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="bundle_warmups" indexName="idx_tenant_state">
            <column name="tenant_id"/>
            <column name="state"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-create-compile-jobs-table" author="system">
        <createTable tableName="compile_jobs">
            <column name="id" type="VARCHAR(200)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="target_version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_by" type="VARCHAR(100)"/>
            <column name="requested_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="operators_fingerprint" type="VARCHAR(255)"/>
            <column name="compiler_id" type="VARCHAR(100)"/>
            <column name="bundle_hash" type="VARCHAR(300)"/>
        </createTable>

        <addUniqueConstraint tableName="compile_jobs"
                             columnNames="tenant_id,rule_id,target_version"
                             constraintName="uk_rule_target"/>

        <createIndex tableName="compile_jobs" indexName="idx_status_time">
            <column name="tenant_id"/>
            <column name="status"/>
            <column name="requested_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="006-create-compile-job-logs-table" author="system">
        <createTable tableName="compile_job_logs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="level" type="VARCHAR(20)"/>
            <column name="msg" type="TEXT"/>
            <column name="timestamp" type="TIMESTAMP"/>
            <column name="compile_job_id" type="VARCHAR(200)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="compile_job_logs"
                                 baseColumnNames="compile_job_id"
                                 constraintName="fk_compile_job_logs_job"
                                 referencedTableName="compile_jobs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="007-create-compile-job-errors-table" author="system">
        <createTable tableName="compile_job_errors">
            <column name="compile_job_id" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(1000)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="compile_job_errors"
                                 baseColumnNames="compile_job_id"
                                 constraintName="fk_compile_job_errors_job"
                                 referencedTableName="compile_jobs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="008-create-engine-configs-table" author="system">
        <createTable tableName="engine_configs">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="timeout_ms" type="INT"/>
            <column name="max_rules_fired" type="INT"/>
            <column name="max_facts" type="INT"/>
            <column name="max_nodes" type="INT"/>
            <column name="max_depth" type="INT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="engine_configs"
                             columnNames="tenant_id"
                             constraintName="uk_tenant"/>
    </changeSet>

    <changeSet id="009-create-engine-config-explain-sampling-table" author="system">
        <createTable tableName="engine_config_explain_sampling">
            <column name="engine_config_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="sampling_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="sampling_value" type="DOUBLE"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="engine_config_explain_sampling"
                                 baseColumnNames="engine_config_id"
                                 constraintName="fk_explain_sampling_config"
                                 referencedTableName="engine_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="010-create-outbox-events-table" author="system">
        <createTable tableName="outbox_events">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="attempts" type="INT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_tried_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="outbox_events" indexName="idx_dispatch_queue">
            <column name="tenant_id"/>
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="011-create-outbox-event-payload-table" author="system">
        <createTable tableName="outbox_event_payload">
            <column name="outbox_event_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payload_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payload_value" type="TEXT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="outbox_event_payload"
                                 baseColumnNames="outbox_event_id"
                                 constraintName="fk_outbox_payload_event"
                                 referencedTableName="outbox_events"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="012-create-validation-rules-table" author="system">
        <createTable tableName="validation_rules">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="version" type="VARCHAR(50)"/>
            <column name="drl_text" type="TEXT"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="validation_rules"
                             columnNames="name"
                             constraintName="uk_rule_name"/>

        <createIndex tableName="validation_rules" indexName="idx_enabled">
            <column name="enabled"/>
        </createIndex>
    </changeSet>

    <changeSet id="013-create-fast-check-configs-table" author="system">
        <createTable tableName="fast_check_configs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="campaign_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="tenant_id" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <!-- Time constraints -->
            <column name="business_hours_start" type="TIME"/>
            <column name="business_hours_end" type="TIME"/>
            <column name="business_hours_timezone" type="VARCHAR(50)"/>
            <column name="exclude_holidays" type="BOOLEAN" defaultValueBoolean="false"/>
            <!-- Order constraints -->
            <column name="min_order_value" type="BIGINT"/>
            <column name="max_order_value" type="BIGINT"/>
            <column name="min_items" type="INT"/>
            <column name="max_items" type="INT"/>
            <!-- Customer constraints -->
            <column name="require_all_segments" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="max_order_count" type="INT"/>
            <!-- Rate limits -->
            <column name="max_per_hour" type="INT"/>
            <column name="max_per_day" type="INT"/>
            <column name="max_per_week" type="INT"/>
            <column name="max_per_month" type="INT"/>
            <column name="window_type" type="VARCHAR(20)"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <addUniqueConstraint tableName="fast_check_configs"
                             columnNames="campaign_id"
                             constraintName="uk_campaign_id"/>

        <createIndex tableName="fast_check_configs" indexName="idx_tenant_id">
            <column name="tenant_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="014-create-blackout-periods-table" author="system">
        <createTable tableName="blackout_periods">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)"/>
            <column name="start_time" type="TIMESTAMP"/>
            <column name="end_time" type="TIMESTAMP"/>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="fast_check_config_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="blackout_periods"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_blackout_periods_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="015-create-flash-sale-windows-table" author="system">
        <createTable tableName="flash_sale_windows">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)"/>
            <column name="daily_start" type="TIME"/>
            <column name="daily_end" type="TIME"/>
            <column name="fast_check_config_id" type="BIGINT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="flash_sale_windows"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_flash_sale_windows_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="016-create-flash-sale-active-days-table" author="system">
        <createTable tableName="flash_sale_active_days">
            <column name="flash_sale_window_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="active_day" type="VARCHAR(10)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="flash_sale_active_days"
                                 baseColumnNames="flash_sale_window_id"
                                 constraintName="fk_active_days_flash_sale"
                                 referencedTableName="flash_sale_windows"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <!-- Create collection tables for fast_check_configs -->
    <changeSet id="017-create-allowed-days-of-week-table" author="system">
        <createTable tableName="allowed_days_of_week">
            <column name="fast_check_config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="day_of_week" type="VARCHAR(10)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="allowed_days_of_week"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_allowed_days_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="018-create-allowed-currencies-table" author="system">
        <createTable tableName="allowed_currencies">
            <column name="fast_check_config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(10)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="allowed_currencies"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_allowed_currencies_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="019-create-categories-tables" author="system">
        <createTable tableName="required_categories">
            <column name="fast_check_config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(100)"/>
        </createTable>

        <createTable tableName="excluded_categories">
            <column name="fast_check_config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="required_categories"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_required_categories_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="excluded_categories"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_excluded_categories_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="020-create-segments-tables" author="system">
        <createTable tableName="allowed_segments">
            <column name="fast_check_config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="segment" type="VARCHAR(100)"/>
        </createTable>

        <createTable tableName="excluded_segments">
            <column name="fast_check_config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="segment" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="allowed_segments"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_allowed_segments_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="excluded_segments"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_excluded_segments_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="021-create-regions-tables" author="system">
        <createTable tableName="allowed_regions">
            <column name="fast_check_config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="region" type="VARCHAR(100)"/>
        </createTable>

        <createTable tableName="excluded_regions">
            <column name="fast_check_config_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="region" type="VARCHAR(100)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="allowed_regions"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_allowed_regions_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="excluded_regions"
                                 baseColumnNames="fast_check_config_id"
                                 constraintName="fk_excluded_regions_config"
                                 referencedTableName="fast_check_configs"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>