<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ==================== BUNDLES TABLE ==================== -->
    <changeSet id="001-01-create-bundles-table" author="system">
        <createTable tableName="bundles">
            <column name="id" type="VARCHAR(300)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rule_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="operators_fingerprint" type="VARCHAR(255)"/>
            <column name="engine_type" type="VARCHAR(50)"/>
            <column name="compiler_id" type="VARCHAR(100)"/>
            <column name="drools_version" type="VARCHAR(20)"/>
            <column name="limit_per_customer" type="INT"/>
            <column name="limit_per_day" type="INT"/>
            <column name="artifact_store" type="VARCHAR(50)"/>
            <column name="artifact_key" type="VARCHAR(255)"/>
            <column name="artifact_size" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="validation_rule_version_id" type="VARCHAR(100)"/>
            <column name="snapshot_hash" type="VARCHAR(255)"/>
            <column name="drl_content" type="TEXT"/>
        </createTable>
        <createIndex tableName="bundles" indexName="idx_rule_version">
            <column name="rule_id"/>
            <column name="rule_version"/>
        </createIndex>
    </changeSet>

    <!-- ==================== BUNDLE TIME LINKS TABLE ==================== -->
    <changeSet id="001-02-create-bundle-time-links-table" author="system">
        <createTable tableName="bundle_time_links">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="policy_id" type="VARCHAR(100)"/>
            <column name="mode" type="VARCHAR(50)"/>
            <column name="bundle_id" type="VARCHAR(300)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="bundle_time_links"
                baseColumnNames="bundle_id"
                constraintName="fk_time_links_bundle"
                referencedTableName="bundles"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- ==================== COMPILE JOBS TABLE ==================== -->
    <changeSet id="001-03-create-compile-jobs-table" author="system">
        <createTable tableName="compile_jobs">
            <column name="id" type="VARCHAR(200)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="rule_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="target_version" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_by" type="VARCHAR(100)"/>
            <column name="requested_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="operators_fingerprint" type="VARCHAR(255)"/>
            <column name="compiler_id" type="VARCHAR(100)"/>
            <column name="bundle_hash" type="VARCHAR(300)"/>
        </createTable>
        <addUniqueConstraint
                tableName="compile_jobs"
                columnNames="rule_id, target_version"
                constraintName="uk_rule_target"/>
        <createIndex tableName="compile_jobs" indexName="idx_status_time">
            <column name="status"/>
            <column name="requested_at"/>
        </createIndex>
    </changeSet>

    <!-- ==================== COMPILE JOB LOGS TABLE ==================== -->
    <changeSet id="001-04-create-compile-job-logs-table" author="system">
        <createTable tableName="compile_job_logs">
            <column name="compile_job_id" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="log_message" type="VARCHAR(2000)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="compile_job_logs"
                baseColumnNames="compile_job_id"
                constraintName="fk_job_logs_compile_job"
                referencedTableName="compile_jobs"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- ==================== COMPILE JOB ERRORS TABLE ==================== -->
    <changeSet id="001-05-create-compile-job-errors-table" author="system">
        <createTable tableName="compile_job_errors">
            <column name="compile_job_id" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="VARCHAR(1000)"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="compile_job_errors"
                baseColumnNames="compile_job_id"
                constraintName="fk_job_errors_compile_job"
                referencedTableName="compile_jobs"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- ==================== ENGINE CONFIGS TABLE ==================== -->
    <changeSet id="001-06-create-engine-configs-table" author="system">
        <createTable tableName="engine_configs">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="timeout_ms" type="INT"/>
            <column name="max_rules_fired" type="INT"/>
            <column name="max_facts" type="INT"/>
            <column name="max_nodes" type="INT"/>
            <column name="max_depth" type="INT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- ==================== ENGINE CONFIG EXPLAIN SAMPLING TABLE ==================== -->
    <changeSet id="001-07-create-engine-config-explain-sampling-table" author="system">
        <createTable tableName="engine_config_explain_sampling">
            <column name="engine_config_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="sampling_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="sampling_value" type="DOUBLE"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="engine_config_explain_sampling"
                baseColumnNames="engine_config_id"
                constraintName="fk_explain_sampling_engine_config"
                referencedTableName="engine_configs"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- ==================== OUTBOX EVENTS TABLE ==================== -->
    <changeSet id="001-08-create-outbox-events-table" author="system">
        <createTable tableName="outbox_events">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="attempts" type="INT"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="last_tried_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="outbox_events" indexName="idx_dispatch_queue">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- ==================== OUTBOX EVENT PAYLOAD TABLE ==================== -->
    <changeSet id="001-09-create-outbox-event-payload-table" author="system">
        <createTable tableName="outbox_event_payload">
            <column name="outbox_event_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payload_key" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="payload_value" type="TEXT"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="outbox_event_payload"
                baseColumnNames="outbox_event_id"
                constraintName="fk_payload_outbox_event"
                referencedTableName="outbox_events"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
