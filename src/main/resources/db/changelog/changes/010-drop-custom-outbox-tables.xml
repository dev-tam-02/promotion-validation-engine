<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="010-01-drop-outbox-event-payload" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="outbox_event_payload"/>
        </preConditions>
        <dropTable tableName="outbox_event_payload"/>
    </changeSet>

    <changeSet id="010-02-drop-outbox-events" author="system">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="outbox_events"/>
        </preConditions>
        <dropTable tableName="outbox_events"/>
    </changeSet>

</databaseChangeLog>
