<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-add-enabled-column-to-bundles" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="bundles" columnName="enabled"/>
            </not>
        </preConditions>
        <comment>Add enabled column to bundles table for bundle activation/deactivation</comment>
        <addColumn tableName="bundles">
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex tableName="bundles" indexName="idx_bundles_enabled">
            <column name="enabled"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
