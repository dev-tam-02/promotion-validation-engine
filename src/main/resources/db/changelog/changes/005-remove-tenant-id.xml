<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Drop tenant_id related indexes from bundles table -->
    <changeSet id="005-01-drop-bundle-tenant-indexes" author="system">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="bundles" indexName="idx_tenant"/>
        </preConditions>
        <dropIndex tableName="bundles" indexName="idx_tenant"/>
    </changeSet>

    <changeSet id="005-02-drop-bundle-rule-version-index" author="system">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="bundles" indexName="idx_rule_version"/>
        </preConditions>
        <dropIndex tableName="bundles" indexName="idx_rule_version"/>
    </changeSet>

    <!-- Recreate idx_rule_version without tenant_id -->
    <changeSet id="005-03-create-new-rule-version-index" author="system">
        <createIndex tableName="bundles" indexName="idx_rule_version">
            <column name="rule_id"/>
            <column name="rule_version"/>
        </createIndex>
    </changeSet>

    <!-- Drop tenant_id column from bundles -->
    <changeSet id="005-04-drop-bundles-tenant-id" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="bundles" columnName="tenant_id"/>
        </preConditions>
        <dropColumn tableName="bundles" columnName="tenant_id"/>
    </changeSet>

    <!-- Drop tenant_id related constraints and columns from bundle_subject_index -->
    <changeSet id="005-05-drop-subject-index-unique-constraint" author="system">
        <preConditions onFail="MARK_RAN">
            <uniqueConstraintExists tableName="bundle_subject_index" constraintName="uk_tenant_subject"/>
        </preConditions>
        <dropUniqueConstraint tableName="bundle_subject_index" constraintName="uk_tenant_subject"/>
    </changeSet>

    <changeSet id="005-06-drop-subject-index-indexes" author="system">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="bundle_subject_index" indexName="idx_subject"/>
        </preConditions>
        <dropIndex tableName="bundle_subject_index" indexName="idx_subject"/>
    </changeSet>

    <changeSet id="005-07-drop-subject-index-rule-ver-idx" author="system">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="bundle_subject_index" indexName="idx_rule_ver"/>
        </preConditions>
        <dropIndex tableName="bundle_subject_index" indexName="idx_rule_ver"/>
    </changeSet>

    <changeSet id="005-08-drop-subject-index-tenant-id" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="bundle_subject_index" columnName="tenant_id"/>
        </preConditions>
        <dropColumn tableName="bundle_subject_index" columnName="tenant_id"/>
    </changeSet>

    <!-- Recreate indexes without tenant_id for bundle_subject_index -->
    <changeSet id="005-09-create-new-subject-indexes" author="system">
        <addUniqueConstraint tableName="bundle_subject_index"
                             columnNames="subject_type,subject_key"
                             constraintName="uk_subject"/>
        <createIndex tableName="bundle_subject_index" indexName="idx_subject">
            <column name="subject_type"/>
            <column name="subject_key"/>
        </createIndex>
        <createIndex tableName="bundle_subject_index" indexName="idx_rule_ver">
            <column name="rule_id"/>
            <column name="rule_version"/>
        </createIndex>
    </changeSet>

    <!-- Drop tenant_id related columns from bundle_warmups -->
    <changeSet id="005-10-drop-warmups-tenant-index" author="system">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="bundle_warmups" indexName="idx_tenant_state"/>
        </preConditions>
        <dropIndex tableName="bundle_warmups" indexName="idx_tenant_state"/>
    </changeSet>

    <changeSet id="005-11-drop-warmups-tenant-id" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="bundle_warmups" columnName="tenant_id"/>
        </preConditions>
        <dropColumn tableName="bundle_warmups" columnName="tenant_id"/>
    </changeSet>

    <changeSet id="005-12-create-new-warmups-index" author="system">
        <createIndex tableName="bundle_warmups" indexName="idx_state">
            <column name="state"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- Drop tenant_id related constraints and columns from compile_jobs -->
    <changeSet id="005-13-drop-compile-jobs-unique-constraint" author="system">
        <preConditions onFail="MARK_RAN">
            <uniqueConstraintExists tableName="compile_jobs" constraintName="uk_rule_target"/>
        </preConditions>
        <dropUniqueConstraint tableName="compile_jobs" constraintName="uk_rule_target"/>
    </changeSet>

    <changeSet id="005-14-drop-compile-jobs-status-index" author="system">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="compile_jobs" indexName="idx_status_time"/>
        </preConditions>
        <dropIndex tableName="compile_jobs" indexName="idx_status_time"/>
    </changeSet>

    <changeSet id="005-15-drop-compile-jobs-tenant-id" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="compile_jobs" columnName="tenant_id"/>
        </preConditions>
        <dropColumn tableName="compile_jobs" columnName="tenant_id"/>
    </changeSet>

    <changeSet id="005-16-create-new-compile-jobs-constraints" author="system">
        <addUniqueConstraint tableName="compile_jobs"
                             columnNames="rule_id,target_version"
                             constraintName="uk_rule_target"/>
        <createIndex tableName="compile_jobs" indexName="idx_status_time">
            <column name="status"/>
            <column name="requested_at"/>
        </createIndex>
    </changeSet>

    <!-- Drop tenant_id related constraints and columns from engine_configs -->
    <changeSet id="005-17-drop-engine-configs-unique-constraint" author="system">
        <preConditions onFail="MARK_RAN">
            <uniqueConstraintExists tableName="engine_configs" constraintName="uk_tenant"/>
        </preConditions>
        <dropUniqueConstraint tableName="engine_configs" constraintName="uk_tenant"/>
    </changeSet>

    <changeSet id="005-18-drop-engine-configs-tenant-id" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="engine_configs" columnName="tenant_id"/>
        </preConditions>
        <dropColumn tableName="engine_configs" columnName="tenant_id"/>
    </changeSet>

    <!-- Drop tenant_id related columns from outbox_events -->
    <changeSet id="005-19-drop-outbox-events-index" author="system">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="outbox_events" indexName="idx_dispatch_queue"/>
        </preConditions>
        <dropIndex tableName="outbox_events" indexName="idx_dispatch_queue"/>
    </changeSet>

    <changeSet id="005-20-drop-outbox-events-tenant-id" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="outbox_events" columnName="tenant_id"/>
        </preConditions>
        <dropColumn tableName="outbox_events" columnName="tenant_id"/>
    </changeSet>

    <changeSet id="005-21-create-new-outbox-events-index" author="system">
        <createIndex tableName="outbox_events" indexName="idx_dispatch_queue">
            <column name="status"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <!-- Drop tenant_id related columns from fast_check_configs -->
    <changeSet id="005-22-drop-fast-check-configs-tenant-index" author="system">
        <preConditions onFail="MARK_RAN">
            <indexExists tableName="fast_check_configs" indexName="idx_tenant_id"/>
        </preConditions>
        <dropIndex tableName="fast_check_configs" indexName="idx_tenant_id"/>
    </changeSet>

    <changeSet id="005-23-drop-fast-check-configs-tenant-id" author="system">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="fast_check_configs" columnName="tenant_id"/>
        </preConditions>
        <dropColumn tableName="fast_check_configs" columnName="tenant_id"/>
    </changeSet>

</databaseChangeLog>
