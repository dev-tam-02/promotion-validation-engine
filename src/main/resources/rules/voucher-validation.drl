package vn.viettel.validation.rules.voucher

import vn.viettel.vds.promotion.validation.engine.domain.model.*

global Candidate candidate

rule "Voucher - Minimum Order Amount"
agenda-group "voucher-validation"
when
    $customer : Customer()
    $order : Order(total < 50000)
    $result : ValidationResult()
    eval(candidate.isVoucher())
then
    $result.setMatched(false);
    $result.setMessage("Order amount must be at least 50,000 VND for voucher");
end

rule "Voucher - VIP Customer Validation"
agenda-group "voucher-validation"
when
    $customer : Customer(segments contains "VIP")
    $order : Order(total >= 50000)
    $result : ValidationResult()
    eval(candidate.isVoucher())
then
    $result.setMatched(true);
    $result.setMessage("VIP customer voucher validation passed");
end

rule "Voucher - Regular Customer Validation"
agenda-group "voucher-validation"
when
    $customer : Customer(segments not contains "VIP")
    $order : Order(total >= 100000)
    $result : ValidationResult()
    eval(candidate.isVoucher())
then
    $result.setMatched(true);
    $result.setMessage("Regular customer voucher validation passed");
end

rule "Voucher - Regular Customer Insufficient Amount"
agenda-group "voucher-validation"
when
    $customer : Customer(segments not contains "VIP")
    $order : Order(total >= 50000, total < 100000)
    $result : ValidationResult()
    eval(candidate.isVoucher())
then
    $result.setMatched(false);
    $result.setMessage("Regular customers need minimum 100,000 VND for voucher");
end