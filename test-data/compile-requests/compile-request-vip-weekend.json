{
  "tenantId": "test-tenant",
  "ruleId": "VIP_WEEKEND_PROMO",
  "version": 2,
  "logic": "ALL",
  "nodes": [
    {
      "id": "root",
      "type": "GROUP",
      "groupLogic": "ALL",
      "children": ["cond-segment", "cond-product"]
    },
    {
      "id": "cond-segment",
      "type": "COND",
      "operatorName": "customer.in_segment",
      "operatorVersion": 1,
      "params": {
        "segments": ["VIP"]
      },
      "reasonCode": "CUSTOMER_NOT_VIP"
    },
    {
      "id": "cond-product",
      "type": "COND",
      "operatorName": "order.item.category.in",
      "operatorVersion": 1,
      "params": {
        "categories": ["SE01", "SE02", "SE03"]
      },
      "reasonCode": "PRODUCT_NOT_ELIGIBLE"
    }
  ],
  "limits": {
    "perCustomer": 5,
    "perDay": 100
  },
  "timeLinks": [
    {
      "policyId": "weekend-policy",
      "mode": "REQUIRED",
      "data": {
        "timezone": "Asia/Bangkok",
        "rrule": "FREQ=WEEKLY;BYDAY=FR,SA,SU",
        "startTs": "2024-01-01T00:00:00Z",
        "endTs": "2024-12-31T23:59:59Z",
        "windows": [
          {
            "startTime": "00:00",
            "endTime": "23:59"
          }
        ]
      }
    }
  ],
  "operatorsFingerprint": "test-v1"
}
