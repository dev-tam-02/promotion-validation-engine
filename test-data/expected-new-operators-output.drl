package tenant1;

import vn.viettel.vds.promotion.rule.engine.domain.model.Customer;
import vn.viettel.vds.promotion.rule.engine.domain.model.Order;
import vn.viettel.vds.promotion.rule.engine.domain.model.OrderItem;
import vn.viettel.vds.promotion.rule.engine.domain.model.Candidate;
import vn.viettel.vds.promotion.rule.engine.domain.model.ValidationResult;

global ValidationResult result;
global java.util.List reasonCodes;

rule "tenant1_new_operators_test_1_validation_rule"
    when
        $customer: Customer()
        $order: Order()
        $candidate: Candidate()
        // Brand check: order.item.brand.in
        exists(OrderItem(brand in ("Nike", "Adidas", "Puma")) from $order.items)
        // Lifetime check: customer.lifetime.value.gte  
        $customer: Customer(lifetimeValue >= 1000000)
        // Metadata check (OR group)
        (
            // Customer metadata: customer.metadata.equals
            $customer: Customer(attrs["region"] == "HCM")
            or
            // Order metadata: order.metadata.equals
            $order: Order(metadata["channel"] == "MOBILE")
        )
    then
        result.setDecision("ALLOW");
        result.setOk(true);
end

rule "tenant1_new_operators_test_1_brand_check_failure"
    when
        $customer: Customer()
        $order: Order()
        $candidate: Candidate()
        not exists(OrderItem(brand in ("Nike", "Adidas", "Puma")) from $order.items)
    then
        reasonCodes.add("BRAND_NOT_ALLOWED");
        result.setDecision("DENY");
        result.setOk(false);
end

rule "tenant1_new_operators_test_1_lifetime_check_failure"
    when
        $customer: Customer(lifetimeValue < 1000000)
        $order: Order()
        $candidate: Candidate()
    then
        reasonCodes.add("LIFETIME_VALUE_TOO_LOW");
        result.setDecision("DENY");
        result.setOk(false);
end

rule "tenant1_new_operators_test_1_customer_metadata_failure"
    when
        $customer: Customer(attrs["region"] != "HCM")
        $order: Order(metadata["channel"] != "MOBILE")
        $candidate: Candidate()
    then
        reasonCodes.add("REGION_NOT_ALLOWED");
        reasonCodes.add("CHANNEL_NOT_ALLOWED");
        result.setDecision("DENY");
        result.setOk(false);
end
